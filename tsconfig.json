{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",          // Ensure JSX is supported
    "allowJs": true,               // Allow JavaScript files
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "redux/user/userSlice.js", 
    "redux/store.js"
  ]
}
